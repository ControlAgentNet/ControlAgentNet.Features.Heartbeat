<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Prompt-driven heartbeat tasks for ControlAgentNet agents.</Description>
    <PackageId>ControlAgentNet.Features.Heartbeat</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ControlAgentNet.Core" Version="0.1.10" />
    <PackageReference Include="ControlAgentNet.Runtime" Version="0.1.10" />
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="ControlAgentNet.Features.CronJobs" Version="0.1.6" />
    <PackageReference Include="ControlAgentNet.Policies" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>


  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>

